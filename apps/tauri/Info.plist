<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Wealthfolio needs camera access to scan QR codes for device pairing.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
    <false/>
	<!-- Server mode can open a self-hosted server at its Tailscale IP over
	     plain HTTP (http://100.x.y.z:8088); tailnet traffic is WireGuard-encrypted.
	     The app itself only accepts such addresses (apps/tauri/src/server_mode.rs). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
